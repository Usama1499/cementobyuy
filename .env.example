# ------------------------------------------------------------------
# Cemento — local / Vercel environment variables
# Copy this file to `.env` and fill in the values, then `bun run dev`.
# This is a Vite + TanStack Start app: browser-visible vars MUST be
# prefixed VITE_. NEXT_PUBLIC_* names are ignored by the bundler.
# ------------------------------------------------------------------

# --- Supabase (your own project) ---------------------------------
# Client (browser)
VITE_SUPABASE_URL="https://mudbizqkcldtskdtomkv.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_W43SaU3KlU5CxmhYM5xEhg_ZYupzRU4"
VITE_SUPABASE_PROJECT_ID="mudbizqkcldtskdtomkv"

# Server (SSR + server functions) — same project, server-side names
SUPABASE_URL="https://mudbizqkcldtskdtomkv.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_W43SaU3KlU5CxmhYM5xEhg_ZYupzRU4"
SUPABASE_PROJECT_ID="mudbizqkcldtskdtomkv"
# Service-role key from Supabase → Project Settings → API keys (sb_secret_...)
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Google Gemini (AI wall visualiser) ---------------------------
# Google AI Studio API key (starts with AIza...). Server only.
GOOGLE_AI_API_KEY=""
# Optional model override
# GEMINI_MODEL="gemini-3.1-flash-lite-image"

